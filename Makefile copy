-include .env

ARGS ?= --network sepolia

.PHONY: all test clean deploy fund help install snapshot format anvil 
help:
	@echo "Usage:"
	@echo "  make deploy [ARGS=...]\n    example: make deploy ARGS=\"--network sepolia\""
	@echo ""
	@echo "  make fund [ARGS=...]\n    example: make deploy ARGS=\"--network sepolia\""

all: clean remove install update build
# Clean the repo
clean  :; forge clean
# Remove modules
remove :; rm -rf .gitmodules && rm -rf .git/modules/* && rm -rf lib && touch .gitmodules && git add . && git commit -m "modules"
install :; forge install cyfrin/foundry-devops@0.1.0 --no-commit && forge install smartcontractkit/chainlink-brownie-contracts@0.6.1 --no-commit && forge install foundry-rs/forge-std@v1.5.3 --no-commit && forge install openzeppelin/openzeppelin-contracts@v4.8.3 --no-commit
# Update Dependencies
update:; forge update

build:; forge build

test :; forge test 

cov :;  forge coverage --report summary

snapshot :; forge snapshot

format :; forge fmt

# anvil target moved below with additional parameters

# Local RPC URL constant definitions
LOCAL_PORT_8545 := 8545
LOCAL_PORT_9000 := 9000
LOCAL_RPC_URL_9000 := http://localhost:$(LOCAL_PORT_9000)
LOCAL_RPC_URL_8545 := http://localhost:$(LOCAL_PORT_8545)


# Anvil related commands
# Start anvil node
a:
	@anvil --state ./anvil-state.json --port $(LOCAL_PORT_9000) --block-time 30

# Transfer ETH to anvil test accounts
ad:
	@echo "Transferring 1000 ETH to deployer...$(DU_DEPLOY_ADDRESS)"
	@cast send $(DU_DEPLOY_ADDRESS) --value 1000ether --private-key $(ANVIL_ACCOUNT_0_PRIVATE_KEY) --rpc-url $(LOCAL_RPC_URL_9000) -vvvv
	@echo "Transferring 900 ETH to gas wallet...$(DU_GAS_WALLET_PUBLIC_ADDRESS)"
	@cast send $(DU_GAS_WALLET_PUBLIC_ADDRESS) --value 900ether --private-key $(ANVIL_ACCOUNT_0_PRIVATE_KEY) --rpc-url $(LOCAL_RPC_URL_9000) -vvvv
ad1:
	@echo "Deploying Coin contract..."
	@forge script script/DeployTokens.s.sol:DeployTokens --fork-url $(LOCAL_RPC_URL_9000) --broadcast --sender $(DU_DEPLOY_ADDRESS) --private-key $(DU_DEPLOY_PRIVATE_KEY)
ad2:
	@echo "Deploying Core contracts..."
	@forge script script/DeployCores.s.sol:DeployCores --fork-url $(LOCAL_RPC_URL_9000) --broadcast --sender $(DU_DEPLOY_ADDRESS) --private-key $(DU_DEPLOY_PRIVATE_KEY)
ad3:
	@echo "Configuring Core contracts..."
	@forge script script/ConfigureDuxFaucet.s.sol:ConfigureDuxFaucet --fork-url $(LOCAL_RPC_URL_9000) --broadcast --sender $(DU_DEPLOY_ADDRESS) --private-key $(DU_DEPLOY_PRIVATE_KEY) -vvvv	

adFaucet:
	@echo "Redeploying Faucet..."
	@forge script script/DeployFaucet.s.sol:DeployFaucet --fork-url $(LOCAL_RPC_URL_9000) --broadcast --sender $(DU_DEPLOY_ADDRESS) --private-key $(DU_DEPLOY_PRIVATE_KEY)
	@forge script script/ConfigureFauceOnetoken.s.sol \
  --sig "run(address,uint256)" \
  0x748eE64B1B846C864Cd50B3e3738332058041286 \
  10000000000000000000000 \
  --fork-url $(LOCAL_RPC_URL_9000) \
  --broadcast \
  --sender $(DU_DEPLOY_ADDRESS) \
  --private-key $(DU_DEPLOY_PRIVATE_KEY)


# Complete deployment flow (execute all steps in order)
adall: ad ad1 ad2 ad3


# Start anvil test node
at:
	@rm -f ./anvil-state-test.json
	@anvil --state ./anvil-state-test.json --port $(LOCAL_PORT_8545)


# ========================================
# Sepolia Testnet Deployment Commands
# ========================================
SEPOLIA_NETWORK_ARGS := --rpc-url $(SEPOLIA_RPC_URL) --private-key $(DU_DEPLOY_PRIVATE_KEY) --broadcast -vvvv
SEPOLIA_NETWORK_ARGS_WITH_VERIFY := --rpc-url $(SEPOLIA_RPC_URL) --private-key $(DU_DEPLOY_PRIVATE_KEY) --broadcast --verify --etherscan-api-key $(ETHERSCAN_API_KEY) -vvvv

# Deploy core contracts (Factory, Router, Faucet) - without verification (recommended first)
deploy-cores:
	@echo "=== Deploying Core Contracts to Sepolia (without verification) ==="
	@forge script script/DeployCores.s.sol:DeployCores $(SEPOLIA_NETWORK_ARGS)

# Deploy core contracts - with verification
deploy-cores-with-verify:
	@echo "=== Deploying Core Contracts to Sepolia (with verification) ==="
	@forge script script/DeployCores.s.sol:DeployCores $(SEPOLIA_NETWORK_ARGS_WITH_VERIFY)

# Deploy test tokens - without verification
deploy-tokens:
	@echo "=== Deploying Test Tokens to Sepolia (without verification) ==="
	@forge script script/DeployTokens.s.sol:DeployTokens $(SEPOLIA_NETWORK_ARGS)

# Deploy test tokens - with verification
deploy-tokens-with-verify:
	@echo "=== Deploying Test Tokens to Sepolia (with verification) ==="
	@forge script script/DeployTokens.s.sol:DeployTokens $(SEPOLIA_NETWORK_ARGS_WITH_VERIFY)


# Check deployment account balance
check-balance:
	@echo "=== Checking Deployment Account Balance ==="
	@cast balance $(DU_DEPLOY_ADDRESS) --rpc-url $(SEPOLIA_RPC_URL)

# Complete deployment flow - without verification
deploy-sepolia: check-balance deploy-cores deploy-tokens configure-faucet
	@echo "=== Sepolia Deployment Complete! ==="

# Complete deployment flow - with verification
deploy-sepolia-with-verify: check-balance deploy-cores-with-verify deploy-tokens-with-verify configure-faucet
	@echo "=== Sepolia Deployment Complete! ==="

# ========================================
# Base Sepolia Testnet Deployment Commands
# ========================================
BASE_SEPOLIA_NETWORK_ARGS := --rpc-url $(BASE_SEPOLIA_RPC_URL) --private-key $(DU_DEPLOY_PRIVATE_KEY) --broadcast -vvvv
BASE_SEPOLIA_NETWORK_ARGS_WITH_VERIFY := --rpc-url $(BASE_SEPOLIA_RPC_URL) --private-key $(DU_DEPLOY_PRIVATE_KEY) --broadcast --verify --verifier etherscan --etherscan-api-key $(BASESCAN_API_KEY) -vvvv

# Deploy core contracts (Factory, Router, Faucet) to Base Sepolia - without verification
deploy-cores-base:
	@echo "=== Deploying Core Contracts to Base Sepolia (without verification) ==="
	@forge script script/DeployCores.s.sol:DeployCores $(BASE_SEPOLIA_NETWORK_ARGS)

# Deploy core contracts to Base Sepolia - with verification
deploy-cores-base-with-verify:
	@echo "=== Deploying Core Contracts to Base Sepolia (with verification) ==="
	@forge script script/DeployCores.s.sol:DeployCores $(BASE_SEPOLIA_NETWORK_ARGS_WITH_VERIFY)

# Deploy test tokens to Base Sepolia - without verification
deploy-tokens-base:
	@echo "=== Deploying Test Tokens to Base Sepolia (without verification) ==="
	@forge script script/DeployTokens.s.sol:DeployTokens $(BASE_SEPOLIA_NETWORK_ARGS)

# Deploy test tokens to Base Sepolia - with verification
deploy-tokens-base-with-verify:
	@echo "=== Deploying Test Tokens to Base Sepolia (with verification) ==="
	@forge script script/DeployTokens.s.sol:DeployTokens $(BASE_SEPOLIA_NETWORK_ARGS_WITH_VERIFY)


# Check Base Sepolia deployment account balance
check-balance-base:
	@echo "=== Checking Deployment Account Balance on Base Sepolia ==="
	@cast balance $(DU_DEPLOY_ADDRESS) --rpc-url $(BASE_SEPOLIA_RPC_URL)

# Complete Base Sepolia deployment flow - without verification
deploy-base-sepolia: check-balance-base deploy-cores-base deploy-tokens-base configure-faucet-base
	@echo "=== Base Sepolia Deployment Complete! ==="

# Complete Base Sepolia deployment flow - with verification
deploy-base-sepolia-with-verify: check-balance-base deploy-cores-base-with-verify deploy-tokens-base-with-verify configure-faucet-base
	@echo "=== Base Sepolia Deployment Complete! ==="



# Remove all tokens from Faucet
remove-all-faucet-tokens:
	@echo "=== Removing all tokens from Faucet ==="
	@forge script script/RemoveAllTokensFromFaucet.s.sol \
		--sig "run(address)" \
		$(FAUCET_ADDRESS) \
		--rpc-url $(THE_RPC) \
		--broadcast \
		--private-key $(DU_DEPLOY_PRIVATE_KEY)