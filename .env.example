# ============== 必须配置 ==============
DU_DEPLOY_PRIVATE_KEY=Your private key for signing deployment transactions
DU_DEPLOY_ADDRESS=Your public address for deployment

# ============== 可选配置 ==============
# 如果需要使用自己的节点（如 Alchemy/Infura），取消注释并填写
 SEPOLIA_RPC_URL=https://rpc.sepolia.org
 BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ============== 可选配置（合约验证时才需要） ==============
ETHERSCAN_API_KEY=Your Etherscan API key for contract verification
BASESCAN_API_KEY=Your Basescan API key for Base Sepolia contract verification

# ============== 其他可选配置 ==============
DU_GAS_WALLET_PUBLIC_ADDRESS=Address for paying user gas fees
ANVIL_ACCOUNT_0_PRIVATE_KEY=Anvil test node private key